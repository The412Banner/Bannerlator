          vec4 i1 = vec4(unpackHalf2x16(sB[b + 2u]), unpackHalf2x16(sB[b + 3u]));
          a0 += W3[28] * i0 + W3[29] * i1;
          a1 += W3[30] * i0 + W3[31] * i1;
        }
        { uint q = (y + 2u) * 20u + x + 2u;
          uint b = q * 4u;
          vec4 i0 = vec4(unpackHalf2x16(sB[b + 0u]), unpackHalf2x16(sB[b + 1u]));
          vec4 i1 = vec4(unpackHalf2x16(sB[b + 2u]), unpackHalf2x16(sB[b + 3u]));
