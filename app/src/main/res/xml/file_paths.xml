<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="external_files" path="." />
    <!-- Downloaded update APKs live in externalCacheDir/update (UpdateManager). -->
    <external-cache-path name="update_cache" path="." />
    <!-- Community config exports are written to internal cacheDir before ACTION_SEND share. -->
    <cache-path name="community_export" path="community_configs/export/" />
    <!-- Log Manager copies a log here before sharing it, so a chooser never gets access to the
         user's own log folder (which can be anywhere they picked). -->
    <cache-path name="log_share" path="logs/share/" />
</paths>
