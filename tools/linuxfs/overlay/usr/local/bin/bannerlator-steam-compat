#!/usr/bin/python3
# Makes the ARM64 Proton the client already downloaded usable here, and sets it as the default tool
# for Windows titles (CompatToolMapping "0" in config.vdf) when the user has not chosen one. Run
# before the client starts; it rewrites config.vdf on exit.
#
#   bannerlator-steam-compat <steam root>
#
# Valve ships a native aarch64 Proton (arm64ec Wine with FEX as the x86 layer) as an ordinary depot,
# which is exactly what this runtime wants. Its toolmanifest declares require_tool_appid 4185400 -
# Steam Linux Runtime 4 for arm64 - so Steam stacks pressure-vessel underneath it, and
# pressure-vessel needs unprivileged user namespaces, which an Android app does not get. Steam then
# drops the launch on the floor: no window, no log, straight back to the library.
#
# So the depot is re-registered here as a compatibility tool of our own: every entry symlinked so
# nothing is copied and Steam still updates the real depot, but with a toolmanifest that leaves out
# require_tool_appid. Proton takes its base directory from dirname(sys.argv[0]) without resolving
# it, so it reads files/ through those symlinks and runs directly on this rootfs.
import os
import re
import shutil
import sys

TOOL = "bannerlator-proton-arm64"
# Valve's own ARM64 Proton, by the name the client registers it under. Used only to bootstrap a
# fresh install: naming it is what makes the client offer it and fetch the depot.
SEED_TOOL = "proton-experimental-arm64"
# The ARM64 Proton depot the client downloads for itself, as a compatibility-tool appid.
# The session asks the client to install it on the command line the first time (steam://install),
# so a new client has it before a Windows title is first launched. It is deliberately NOT named as
# this tool's dependency: a dependency is composed with its own dependencies, and this depot
# requires 4185400, the arm64 Steam Linux Runtime, whose container needs user namespaces Android
# does not give - the launch would be wrapped in it and die before this tool ever ran.
PROTON_ARM64_APPID = "4427310"
LAUNCHER = "bannerlator-proton"
# The extra Steam library the app mounts the installed games into (see bannerlator-steam-library).
# installed_apps() scans it too; it lives only in the sibling script, so define it here as well.
LIBRARY = "/mnt/bannerlator"  # the card library is LIBRARY + "-sd"; internal storage is steam_root itself
# The client lists its own "Proton Experimental (ARM64)" and "Proton 11.0 (ARM64)" in the same
# Compatibility dropdown, and those are the two that cannot start a game here. Ours has to be
# unmistakable at a glance, or a user picks a neighbour and gets a launch that fails silently.
# Newest first: whichever the client has downloaded is used.
SOURCES = ("Proton Experimental (ARM64)", "Proton 11.0 (ARM64)")
# Written by us; everything else in the depot is symlinked through.
OWN_FILES = ("toolmanifest.vdf", "compatibilitytool.vdf", "bannerlator-proton")
# The client assigns a Proton to a Windows title by itself, as a per-app CompatToolMapping entry at
# priority 250 - which outranks the "0" default, so setting that default alone changes nothing. Every
# Proton it can pick is one this runtime cannot start: the ARM64 ones want pressure-vessel (see
# above) and the x86_64 ones want pressure-vessel and FEX on top. Ours is the only one that runs
# here, so every Proton mapping is repointed at it. Tools that are not Proton are left alone.
COMPAT_TOOL_VDF = """"compatibilitytools"
{
	"compat_tools"
	{
		"%s"
		{
			"install_path" "."
			"display_name" "Bannerlator Proton (ARM64)"
			"from_oslist" "windows"
			"to_oslist" "linux"
		}
	}
}
"""
TOOL_MANIFEST_VDF = """"manifest"
{
	"version" "2"
	"commandline" "/%s %%verb%%"
	"use_sessions" "1"
	"compatmanager_layer_name" "proton"
}
""" % LAUNCHER

# Shared by both wrappers: points Wine at the DirectAudio driver the app staged, and names it in
# the prefix so Wine will try it at all. Only when the app asked for it (BL_DIRECTAUDIO holds the
# directory), and only on a Proton whose Wine major the driver was built against - the interface it
# implements is private and unversioned, so a mismatch is SILENCE rather than an error, which is
# indistinguishable from us having broken the sound.
# Cores for a game the client launches, kept separate from the client's own. One mask suits the
# client's menus and another suits a game, and they are wanted at the same time - so the game's is
# applied here, in the launch path every game goes through, rather than to the session as a whole.
BL_GAME_CPUS_SETUP = """
bl_game_cpus() {
  [ -n "${BL_GAME_CPUS:-}" ] || return 0
  command -v taskset >/dev/null 2>&1 || return 0
  # exec'd through taskset rather than set afterwards: a mask applied to a pid races the process
  # into spawning its own threads, and this way every thread inherits it from the first instruction.
  BL_TASKSET="taskset -c $BL_GAME_CPUS"
  echo "bannerlator-proton: game cores $BL_GAME_CPUS" >&2
}
"""

# Per-game options the app can change while the session runs. The app keeps each one in a file under
# BL_LIVE_DIR (bound into the session at its own path), and they are read here, at every game start,
# so a change in the in-game drawer reaches the next game without restarting the client.
# - idtech3: Quake III engine games (id Tech 3) set their own resolution and switch the display to
#   it. Under gamescope with the ARM64 Proton that switch is refused ("calling CDS: failed, bad mode")
#   and the game never gets OpenGL; left at its own size in a window, it draws small in a corner. So
#   these titles are told to stay windowed at the session's own size - unless the user's launch
#   options already say something about the video mode, which are left as they are. "0" turns it off.
#   (From The412Banner/DroidDeck.)
# - xalia: "0" sets PROTON_USE_XALIA=0, Proton's own gate for its xalia accessibility helper, which
#   crash-looped one Galaxy Fold. Anything else leaves Proton to decide, as Valve ships it.
BL_GAME_OPTIONS_SETUP = """
bl_game_options() {
  BL_EXTRA_ARGS=()
  live=${BL_LIVE_DIR:-}
  if [ -n "$live" ] && [ "$(cat "$live/xalia" 2>/dev/null)" = 0 ]; then
    PROTON_USE_XALIA=0
    export PROTON_USE_XALIA
    echo "bannerlator-proton: xalia off (PROTON_USE_XALIA=0)" >&2
  fi
  [ -n "$live" ] && [ "$(cat "$live/idtech3" 2>/dev/null)" = 0 ] && return 0
  case "${SteamAppId:-${STEAM_COMPAT_APP_ID:-}}" in
    # Quake III Arena, Quake III: Team Arena, Return to Castle Wolfenstein, Jedi Academy.
    2200|2350|9010|6020) ;;
    *) return 0 ;;
  esac
  case " $* " in
    *r_fullscreen*|*r_mode*|*r_customwidth*|*r_customheight*)
      echo "bannerlator-proton: Quake-engine title; its launch options set the video mode, left as they are" >&2
      return 0 ;;
  esac
  w=${BL_WIDTH:-1280}
  h=${BL_HEIGHT:-720}
  BL_EXTRA_ARGS=(+set r_fullscreen 0 +set r_mode -1 +set r_customwidth "$w" +set r_customheight "$h")
  echo "bannerlator-proton: Quake-engine title: windowed at ${w}x${h}" >&2
}
"""

BL_DIRECTAUDIO_SETUP = """
bl_directaudio() {
  base=$1
  # PulseAudio is named after DirectAudio as its fallback. mmdevapi keeps the first driver in the
  # list that loads unless a later one ranks higher, and both rank Preferred when they work, so
  # DirectAudio still wins wherever it loads. Where it cannot - a Proton that finds no build of it
  # for the game's architecture (Valve's ARM64 Proton looks in x86_64-windows for a 64-bit game),
  # or DirectAudio switched off, which leaves it off WINEDLLPATH - the game gets PulseAudio instead
  # of no audio device at all, which crashed Titanfall 2 in xaudio2_7. A prefix that already holds
  # the DirectAudio-only value from earlier builds gets the list, whether or not DirectAudio is on.
  # What Wine will read is the last Audio value under that key: an appended section wins until the
  # wineserver folds the file together, so the value is taken from the end, not the first match.
  reg="${STEAM_COMPAT_DATA_PATH:-}/pfx/user.reg"
  audio=
  [ -f "$reg" ] && audio=$(awk '/^[[]Software.*Wine.*Drivers[]]/ { f = 1; next } /^[[]/ { f = 0 } f && /^"Audio"=/ { v = $0 } END { print v }' "$reg" 2>/dev/null)
  if [ "$audio" = '"Audio"="directaudio"' ]; then
    printf '\n[%s] %s\n"Audio"="directaudio,pulse"\n' 'Software\\\\Wine\\\\Drivers' "$(date +%s)" >> "$reg"
    echo "bannerlator-proton: the prefix's DirectAudio-only driver list now falls back to PulseAudio" >&2
  fi
  [ -n "${BL_DIRECTAUDIO:-}" ] || return 0
  [ -d "$BL_DIRECTAUDIO/lib/wine" ] || return 0
  version=$("$base/files/bin-arm64/wine" --version 2>/dev/null)
  major=${version#wine-}
  major=${major%%.*}
  if [ "$major" != "11" ]; then
    echo "bannerlator-proton: DirectAudio left off - it is built for Wine 11 and this Proton is '${version:-unknown}'. Pairing them would be silent rather than broken, so it is not worth guessing." >&2
    return 0
  fi
  # Wine appends the per-architecture subdirectory to each entry, so the directory holding
  # aarch64-unix/ and aarch64-windows/ is what goes here.
  WINEDLLPATH="$BL_DIRECTAUDIO/lib/wine${WINEDLLPATH:+:$WINEDLLPATH}"
  export WINEDLLPATH
  # mmdevapi only tries the drivers named in the registry; its built-in list is pulse, alsa, oss and
  # coreaudio and knows nothing about this one. The key is appended to the prefix's user.reg rather
  # than written with `wine reg`, which would start a wineserver here just to set one value.
  # In user.reg a key's backslashes are written doubled. The key goes in through %s, which printf
  # leaves as it is, because a backslash in printf's format is an escape and halves them. Earlier
  # builds wrote the format form, so the value sat under a key named SoftwareWineDrivers that Wine
  # never reads. The check below looks for the real key, so those prefixes are repaired on their
  # next launch.
  if [ -f "$reg" ]; then
    if [ "$audio" != '"Audio"="directaudio"' ] && [ "$audio" != '"Audio"="directaudio,pulse"' ]; then
      printf '\n[%s] %s\n"Audio"="directaudio,pulse"\n' 'Software\\\\Wine\\\\Drivers' "$(date +%s)" >> "$reg"
      echo "bannerlator-proton: DirectAudio selected in the prefix" >&2
    fi
  else
    # A prefix that does not exist yet is created by Proton moments from now, after this runs, so
    # the key lands on the NEXT launch of that game. Said out loud because silent audio on a first
    # launch would otherwise look like a fault.
    echo "bannerlator-proton: no prefix yet - DirectAudio takes effect the next time this game starts" >&2
  fi
  echo "bannerlator-proton: DirectAudio ready (Wine $major)" >&2
}
"""

# Resolves the depot at launch time, so the tool can be registered before the depot exists and
# survives the client updating or replacing it. Proton takes its base directory from
# dirname(sys.argv[0]) without resolving it, so it is run from the depot itself.
LAUNCHER_SH = """#!/bin/bash
# Bannerlator Proton (ARM64): runs the ARM64 Proton the Steam client downloaded, without the
# Steam Linux Runtime container its own manifest asks for (no user namespaces on Android).
verb=$1; shift
steam_root=${STEAM_COMPAT_CLIENT_INSTALL_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/Steam}
# Steam's overlay is preloaded into every game Valve launches, and used to be dropped here: it was
# landing in front of open() and read() on /dev/input, letting Wine open the session's pad and
# answering every read of it with nothing - a controller that never reports, and Wine's HID thread
# spinning a core on it.
#
# Removing it was the wrong cure for an ordering problem. glibc processes LD_PRELOAD BEFORE
# /etc/ld.so.preload, and the interposer lives in the latter, so the overlay was simply ahead of it.
# Naming the interposer first in LD_PRELOAD puts it back in front and the overlay loads as Valve
# intends. That matters beyond the overlay itself: every deviation from the launch Valve ships is a
# difference this runtime would otherwise have to justify.
fake=/usr/local/lib/libfakeinput.so
if [ -f "$fake" ]; then
  case ":${LD_PRELOAD:-}:" in
    *":$fake:"*) ;;
    *) LD_PRELOAD="$fake${LD_PRELOAD:+:$LD_PRELOAD}"; export LD_PRELOAD ;;
  esac
fi
for name in %s; do
  depot="$steam_root/steamapps/common/$name"
  if [ -d "$depot/files/bin-arm64" ] && [ -x "$depot/proton" ]; then
    bl_directaudio "$depot"
    bl_game_cpus
    bl_game_options "$@"
    exec ${BL_TASKSET:-} "$depot/proton" "$verb" "$@" "${BL_EXTRA_ARGS[@]}"
  fi
done
echo "bannerlator-proton: no ARM64 Proton depot yet - the client downloads one as this tool's dependency; retry the launch once it has" >&2
exit 1
""" % " ".join('"%s"' % n for n in SOURCES)
# Spliced in after the formatting above, never through it: the function body contains ${major%%.*}
# and a % format would eat that into a single %, leaving a shell expansion that silently does
# something else.
LAUNCHER_SH = LAUNCHER_SH.replace(
    "verb=$1; shift", "verb=$1; shift\n" + BL_DIRECTAUDIO_SETUP + BL_GAME_CPUS_SETUP + BL_GAME_OPTIONS_SETUP, 1)

# A third-party Proton dropped into compatibilitytools.d - GE-Proton, proton-cachyos, anything of
# that shape - is adopted rather than used as shipped, for the same two reasons Valve's ARM64 depot
# is: its manifest declares require_tool_appid, and the client's overlay library has to come out of
# LD_PRELOAD. Its own entry point is left untouched and called through this wrapper.
EXTRA_WRAPPER = "bannerlator-proton-wrap"
EXTRA_MANIFEST_VDF = """"manifest"
{
	"version" "2"
	"commandline" "/%s %%verb%%"
	"use_sessions" "1"
	"compatmanager_layer_name" "proton"
}
""" % EXTRA_WRAPPER
# %s is the tool's own entry point, read out of the manifest it shipped with.
EXTRA_WRAPPER_SH = """#!/bin/bash
# Bannerlator: runs a Proton installed into compatibilitytools.d without the Steam Linux Runtime
# container its own manifest asks for - pressure-vessel needs unprivileged user namespaces, which
# an Android app does not get, and the launch dies before Proton is reached.
verb=$1; shift
here=$(dirname "$0")
# See bannerlator-proton: the interposer goes first in LD_PRELOAD rather than the overlay being
# removed, because glibc reads LD_PRELOAD before /etc/ld.so.preload and the overlay was simply
# ahead of it on /dev/input.
fake=/usr/local/lib/libfakeinput.so
if [ -f "$fake" ]; then
  case ":${LD_PRELOAD:-}:" in
    *":$fake:"*) ;;
    *) LD_PRELOAD="$fake${LD_PRELOAD:+:$LD_PRELOAD}"; export LD_PRELOAD ;;
  esac
fi
bl_directaudio "$here"
bl_game_cpus
bl_game_options "$@"
# Proton takes its base directory from dirname(sys.argv[0]) without resolving it, so it has to be
# started from its own tree.
exec ${BL_TASKSET:-} "$here/%s" "$verb" "$@" "${BL_EXTRA_ARGS[@]}"
"""

EXTRA_COMPAT_TOOL_VDF = """"compatibilitytools"
{
	"compat_tools"
	{
		"%s"
		{
			"install_path" "."
			"display_name" "%s (Bannerlator)"
			"from_oslist" "windows"
			"to_oslist" "linux"
		}
	}
}
"""


TOKEN = re.compile(r'\s*(?:"((?:[^"\\]|\\.)*)"|([{}])|//[^\n]*)')


def tokenize(text):
    tokens = []
    pos = 0
    while pos < len(text):
        m = TOKEN.match(text, pos)
        if not m or m.end() == pos:
            break
        pos = m.end()
        if m.group(2):
            tokens.append(m.group(2))
        elif m.group(1) is not None:
            tokens.append('"' + m.group(1) + '"')
    return tokens


def find_block(tokens, path):
    """Index of the '{' opening the block at path, or None."""
    depth, want, i = 0, 0, 0
    while i < len(tokens):
        t = tokens[i]
        if t == "{":
            depth += 1
        elif t == "}":
            depth -= 1
            if depth < want:
                return None
        elif depth == want and i + 1 < len(tokens) and tokens[i + 1] == "{":
            if t.lower() == '"%s"' % path[want].lower():
                if want == len(path) - 1:
                    return i + 1
                want += 1
        i += 1
    return None


def block_end(tokens, start):
    depth = 0
    for i in range(start, len(tokens)):
        if tokens[i] == "{":
            depth += 1
        elif tokens[i] == "}":
            depth -= 1
            if depth == 0:
                return i
    return len(tokens)


def serialize(tokens):
    out, depth, i = [], 0, 0
    while i < len(tokens):
        t = tokens[i]
        if t == "}":
            depth -= 1
            out.append("\t" * depth + "}")
            i += 1
        elif i + 1 < len(tokens) and tokens[i + 1] == "{":
            out.append("\t" * depth + t)
            out.append("\t" * depth + "{")
            depth += 1
            i += 2
        else:
            out.append("\t" * depth + t + "\t\t" + tokens[i + 1])
            i += 2
    return "\n".join(out) + "\n"


def first_key(path, section):
    """The single key naming a block inside `section`, or None. Used to keep a third-party tool's
    own internal name, so a mapping the user already made against it keeps working."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            tokens = tokenize(f.read())
    except OSError:
        return None
    block = find_block(tokens, section)
    if block is None:
        return None
    for i in range(block + 1, block_end(tokens, block)):
        if tokens[i] == "}":
            break
        if i + 1 < len(tokens) and tokens[i + 1] == "{":
            return tokens[i].strip('"')
    return None


def manifest_entry_point(path):
    """The script a toolmanifest's commandline runs, relative to the tool directory."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            tokens = tokenize(f.read())
    except OSError:
        return None
    for i in range(len(tokens) - 1):
        if tokens[i].lower() == '"commandline"':
            command = tokens[i + 1].strip('"').split()
            if command:
                return command[0].lstrip("/")
    return None


def adopt_extras(tools):
    """Makes every other Proton in compatibilitytools.d launchable here, and returns the tool names
    to leave alone in CompatToolMapping - the whole point of installing one is to pick it per game,
    so register_default must not repoint it back at ours."""
    adopted = {}
    try:
        entries = sorted(os.listdir(tools))
    except OSError:
        return adopted
    for entry in entries:
        if entry == TOOL or entry.startswith("."):
            continue
        tool_dir = os.path.join(tools, entry)
        manifest = os.path.join(tool_dir, "toolmanifest.vdf")
        if not os.path.isdir(tool_dir) or not os.path.isfile(manifest):
            continue
        # The shipped manifest is kept, once, and stays the source of the entry point: re-running
        # must not read back our own rewritten commandline and wrap the wrapper.
        original = manifest + ".bannerlator-orig"
        if not os.path.isfile(original):
            try:
                shutil.copy2(manifest, original)
            except OSError:
                continue
        entry_point = manifest_entry_point(original)
        if not entry_point or entry_point == EXTRA_WRAPPER:
            entry_point = "proton"
        if not os.path.exists(os.path.join(tool_dir, entry_point)):
            print("bannerlator-steam-compat: %s has no %s; left alone" % (entry, entry_point))
            continue
        compat_vdf = os.path.join(tool_dir, "compatibilitytool.vdf")
        name = first_key(compat_vdf, ["compatibilitytools", "compat_tools"]) or entry
        wrapper = os.path.join(tool_dir, EXTRA_WRAPPER)
        try:
            # Formatted first, spliced second: the function carries a printf %s and a
            # ${major%%.*} of its own, and putting it through the format would eat both.
            body = (EXTRA_WRAPPER_SH % entry_point).replace(
                    'here=$(dirname "$0")',
                    'here=$(dirname "$0")\n' + BL_DIRECTAUDIO_SETUP + BL_GAME_CPUS_SETUP + BL_GAME_OPTIONS_SETUP, 1)
            with open(wrapper, "w", encoding="utf-8") as f:
                f.write(body)
            os.chmod(wrapper, 0o755)
            with open(manifest, "w", encoding="utf-8") as f:
                f.write(EXTRA_MANIFEST_VDF)
            with open(compat_vdf, "w", encoding="utf-8") as f:
                f.write(EXTRA_COMPAT_TOOL_VDF % (name, entry))
        except OSError as e:
            print("bannerlator-steam-compat: could not adopt %s (%s)" % (entry, e))
            continue
        adopted[name] = entry
    return adopted


# Steam's own tools and runtimes live in steamapps beside the games; they are not titles and must
# not be mapped to a compatibility tool.
NOT_GAMES = frozenset((
    "228980",    # Steamworks Common Redistributables
    "1070560",   # Steam Linux Runtime 1.0 (scout)
    "1391110",   # Steam Linux Runtime 2.0 (soldier)
    "1493710",   # Proton Experimental
    "3127680",   # FEX
    "4183110",   # Steam Linux Runtime 4.0
    "4185400",   # Steam Linux Runtime 4.0 - Arm64
    "4427310",   # Proton Experimental (ARM64)
    "4628740",   # Proton 11.0 (ARM64)
))


# The anti-cheat runtimes a game brings with it are Linux apps to the client, and a Linux app is
# run in the Steam Linux Runtime: installing one has the client fetch scout and soldier, hundreds
# of megabytes of x86 container that cannot start here. Set to this tool they depend on nothing.
# Nothing ever runs them - Proton reads their files - so the tool named is never started for them.
# (WinNative, maxjivi05, 7804d460.)
ANTICHEAT_RUNTIMES = (
    "1161040",   # Proton BattlEye Runtime
    "1826330",   # Proton EasyAntiCheat Runtime
)

# Every Steam game the account OWNS, one app id per line, written by the app before the session.
# Valve names a Proton of its own for thousands of titles at a priority above the client's default
# tool, so a title set only after install had the client fetch an x86-64 Proton, its runtime and
# FEX first - gigabytes that cannot run here - and then fail to start. Mapped before install, it
# fetches the ARM64 tool it can use. (After WinNative 8874cfc7, which reads the store directly.)
OWNED_APPS_FILE = os.path.expanduser("~/.bl-owned-apps")


def owned_apps():
    try:
        with open(OWNED_APPS_FILE) as f:
            return {line.strip() for line in f if line.strip().isdigit()}
    except OSError:
        return set()


def installed_apps(steam_root):
    """App ids of the titles the client has installed, tools and runtimes excluded."""
    apps = set()
    for library in (steam_root, LIBRARY + "-sd"):
        steamapps = os.path.join(library, "steamapps")
        try:
            names = os.listdir(steamapps)
        except OSError:
            continue
        for name in names:
            m = re.fullmatch(r"appmanifest_(\d+)\.acf", name)
            if m and m.group(1) not in NOT_GAMES:
                apps.add(m.group(1))
    return sorted(apps, key=int)


def mapped_apps(steam_root):
    """Everything to run with this tool: installed titles, owned titles, the anti-cheat runtimes."""
    apps = set(installed_apps(steam_root)) | (owned_apps() - NOT_GAMES) | set(ANTICHEAT_RUNTIMES)
    return sorted(apps, key=int)


def register_default(config_path, apps=(), name=None, protect=()):
    """Writes the mapping. `name` defaults to our own tool; the first-run seed passes Valve's."""
    tool = name or TOOL
    # Tool names the user may deliberately have chosen (see adopt_extras); never repointed.
    keep = {n.lower() for n in protect}
    with open(config_path, encoding="utf-8", errors="replace") as f:
        tokens = tokenize(f.read())
    steam = find_block(tokens, ["InstallConfigStore", "Software", "Valve", "Steam"])
    if steam is None:
        return
    mapping = find_block(tokens[steam + 1:], ["CompatToolMapping"])
    entry = ['"0"', "{", '"name"', '"%s"' % tool, '"config"', '""', '"priority"', '"75"', "}"]
    if mapping is None:
        end = block_end(tokens, steam)
        tokens[end:end] = ['"CompatToolMapping"', "{"] + entry + ["}"]
    else:
        mapping += steam + 1
        # Repoint every per-app entry the client aimed at a Proton it cannot actually start.
        for i in range(mapping, block_end(tokens, mapping)):
            named = tokens[i + 1].strip('"').lower()
            if (tokens[i] == '"name"' and named.startswith("proton")
                    and named != tool.lower() and named not in keep):
                tokens[i + 1] = '"%s"' % tool
        if find_block(tokens[mapping + 1:], ["0"]) is None:
            tokens[mapping + 1:mapping + 1] = entry
        # The "0" default only decides how a title is installed, so it settles new downloads and
        # leaves anything already installed as a Linux build running as one. An entry per installed
        # app is what the client's own Compatibility checkbox writes, and is what makes it switch.
        for app in apps:
            if find_block(tokens[mapping + 1:], [app]) is not None:
                continue
            tokens[mapping + 1:mapping + 1] = [
                '"%s"' % app, "{", '"name"', '"%s"' % tool, '"config"', '""', '"priority"', '"250"', "}"]
    tmp = config_path + ".bannerlator"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(serialize(tokens))
    os.replace(tmp, config_path)


def find_source(steam_root):
    """The ARM64 Proton depot the client has downloaded, or None."""
    common = os.path.join(steam_root, "steamapps", "common")
    for name in SOURCES:
        depot = os.path.join(common, name)
        # bin-arm64 is what makes it the native build rather than the x86_64 one.
        if os.path.isdir(os.path.join(depot, "files", "bin-arm64")):
            return depot
    return None


def build_tool(tool_dir):
    """Our own manifests and the launcher. The depot is found at launch time, not here."""
    if os.path.islink(tool_dir):
        os.unlink(tool_dir)
    elif os.path.isdir(tool_dir):
        # Earlier versions mirrored the depot in here as symlinks; start clean.
        shutil.rmtree(tool_dir)
    os.makedirs(tool_dir)
    with open(os.path.join(tool_dir, "toolmanifest.vdf"), "w", encoding="utf-8") as f:
        f.write(TOOL_MANIFEST_VDF)
    with open(os.path.join(tool_dir, "compatibilitytool.vdf"), "w", encoding="utf-8") as f:
        f.write(COMPAT_TOOL_VDF % TOOL)
    launcher = os.path.join(tool_dir, LAUNCHER)
    with open(launcher, "w", encoding="utf-8") as f:
        f.write(LAUNCHER_SH)
    os.chmod(launcher, 0o755)


def main():
    steam_root = sys.argv[1]
    tools = os.path.join(steam_root, "compatibilitytools.d")
    os.makedirs(tools, exist_ok=True)
    build_tool(os.path.join(tools, TOOL))
    extras = adopt_extras(tools)
    for name, directory in sorted(extras.items()):
        print("bannerlator-steam-compat: adopted %s as %s" % (directory, name))
    depot = find_source(steam_root)
    print("bannerlator-steam-compat: registered %s (%s)" % (
        TOOL, "depot %s present" % os.path.basename(depot) if depot else
        "no ARM64 Proton depot yet; the session asks the client to fetch it"))
    config = os.path.join(steam_root, "config", "config.vdf")
    if os.path.isfile(config):
        apps = mapped_apps(steam_root)
        register_default(config, apps, protect=extras)
        print("bannerlator-steam-compat: default and %d app(s) set to %s (installed + owned + anti-cheat runtimes)" % (len(apps), TOOL))


if __name__ == "__main__":
    main()
