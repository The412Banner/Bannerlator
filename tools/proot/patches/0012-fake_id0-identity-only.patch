From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DroidDeck <droiddeck@users.noreply.github.com>
Date: Tue, 29 Sep 2026 00:00:00 +0000
Subject: [PATCH] fake_id0: only trace the set*id and xattr calls when the ids
 are PRoot's own

Ported to termux/proot v5.1.107.92 for Bannerlator: that tree's fake_id0 Config already
includes <stdbool.h> and ends with caps_active and keep_caps, so the identity field goes
after them. Its full list also traces prctl, whose handler only mirrors PR_SET_KEEPCAPS for
caps_active; caps_active starts false for a non-zero uid and is only set by the setuid
execve path this mode skips, so prctl stays out of identity_sysnums, as the comment says.

---
 src/extension/fake_id0/config.h   |  4 ++++
 src/extension/fake_id0/fake_id0.c | 46 ++++++++++++++++++++++++++++++-
 2 files changed, 49 insertions(+), 1 deletion(-)

diff --git a/src/extension/fake_id0/config.h b/src/extension/fake_id0/config.h
index be0132d..f8677c4 100644
--- a/src/extension/fake_id0/config.h
+++ b/src/extension/fake_id0/config.h
@@ -31,6 +31,10 @@ typedef struct {
 	 * a follow-up capset() lets a process retain CAP_SETUID/CAP_SETGID
 	 * across setresuid().  Cleared by execve, per Linux semantics. */
 	bool keep_caps;
+
+	/* The emulated ids are the ones PRoot really has: see
+	 * identity_sysnums in fake_id0.c.  */
+	bool identity;
 } Config;
 
 #endif /* FAKE_ID0_CONFIG_H */
diff --git a/src/extension/fake_id0/fake_id0.c b/src/extension/fake_id0/fake_id0.c
index 9bd8dad..2914589 100644
--- a/src/extension/fake_id0/fake_id0.c
+++ b/src/extension/fake_id0/fake_id0.c
@@ -384,6 +384,42 @@ static FilteredSysnum filtered_sysnums[] = {
 	FILTERED_SYSNUM_END,
 };
 
+/* When the emulated ids are the ones PRoot really has, and the tracee
+ * is not root, every handler for the syscalls above but these is a
+ * no-op: stat and get*id report the real ids already, SCM_CREDENTIALS
+ * and SO_PEERCRED carry them, chown swaps an id for itself, and the
+ * permission and chroot fixups only apply to euid 0.  The set*id
+ * family is still emulated (Android's app seccomp policy traps it) and
+ * so are the xattr permission fixups, which apply to any euid.  An
+ * unprivileged set*id can only take an id the tracee already holds,
+ * and set-user-ID bits are not honoured in this mode (Android mounts
+ * the app's data nosuid, so the kernel would not honour them either),
+ * so the ids never change and the list stays sufficient.  The prctl
+ * handler only mirrors PR_SET_KEEPCAPS, which matters only while
+ * caps_active is set, and caps_active is never set in this mode.  */
+static FilteredSysnum identity_sysnums[] = {
+	{ PR_fsetxattr,		FILTER_SYSEXIT },
+	{ PR_lsetxattr,		FILTER_SYSEXIT },
+	{ PR_setfsgid,		FILTER_SYSEXIT },
+	{ PR_setfsgid32,	FILTER_SYSEXIT },
+	{ PR_setfsuid,		FILTER_SYSEXIT },
+	{ PR_setfsuid32,	FILTER_SYSEXIT },
+	{ PR_setgid,		FILTER_SYSEXIT },
+	{ PR_setgid32,		FILTER_SYSEXIT },
+	{ PR_setregid,		FILTER_SYSEXIT },
+	{ PR_setregid32,	FILTER_SYSEXIT },
+	{ PR_setresgid,		FILTER_SYSEXIT },
+	{ PR_setresgid32,	FILTER_SYSEXIT },
+	{ PR_setresuid,		FILTER_SYSEXIT },
+	{ PR_setresuid32,	FILTER_SYSEXIT },
+	{ PR_setreuid,		FILTER_SYSEXIT },
+	{ PR_setreuid32,	FILTER_SYSEXIT },
+	{ PR_setuid,		FILTER_SYSEXIT },
+	{ PR_setuid32,		FILTER_SYSEXIT },
+	{ PR_setxattr,		FILTER_SYSEXIT },
+	FILTERED_SYSNUM_END,
+};
+
 /**
  * Restore the @node->mode for the given @node->path.
  *
@@ -1169,6 +1205,11 @@ static int handle_sysexit_start(Tracee *tracee, Config *config) {
 	if ((int) result < 0 || tracee->status < 0 || sysnum != PR_execve)
 		return 0;
 
+	/* The auxv already carries the real ids, and set-user-ID bits
+	 * are not honoured in this mode: see identity_sysnums.  */
+	if (config->identity)
+		return 0;
+
 	/* This has to be done before PRoot pushes the load
 	 * script into tracee's stack.  */
 	if (!tracee->skip_proot_loader)
@@ -1244,7 +1285,10 @@ int fake_id0_callback(Extension *extension, ExtensionEvent event, intptr_t data1
 			/* Set the umask to the typical linux value. */
 			config->umask = 022;
 
-		extension->filtered_sysnums = filtered_sysnums;
+		config->identity = (uid != 0 && uid == (int) getuid() && gid == (int) getgid());
+		extension->filtered_sysnums = config->identity
+			? identity_sysnums
+			: filtered_sysnums;
 		return 0;
 	}
 
