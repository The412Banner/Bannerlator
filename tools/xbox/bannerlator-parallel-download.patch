+// Bannerlator: parallel downloading across the package's CDN hosts with an adaptive request window.
+static CDN_MIRRORS: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+static DOWNLOADED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static NEXT_MIRROR: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+/// Files larger than this are fetched as page-aligned chunks in parallel.
+const CHUNK_BYTES: u64 = 64 * 1024 * 1024;
+const WINDOW_START: usize = 4;
+
+/// The CDN hosts that answer a ranged request for this package (the first one always stays).
+async fn usable_mirrors(client: &reqwest::Client, primary: &str) -> Vec<String> {
+    let mut out = vec![primary.to_owned()];
+    for mirror in CDN_MIRRORS.get().cloned().unwrap_or_default() {
+        if out.contains(&mirror) {
+            continue;
+        }
+        let probe = client.get(&mirror).header(reqwest::header::RANGE, "bytes=0-0").send();
+        if let Ok(Ok(response)) = tokio::time::timeout(tokio::time::Duration::from_secs(5), probe).await
+            && response.status() == 206
+        {
+            out.push(mirror);
+        }
+    }
+    out
+}
+
+fn pick_mirror(mirrors: &[String]) -> &str {
+    let i = NEXT_MIRROR.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    &mirrors[i % mirrors.len()]
+}
+
+/// Grows the number of requests in flight from WINDOW_START toward `ceiling` while throughput keeps
+/// rising, and gives one back when it falls well below the best seen. Ends when `done` is set.
+fn adapt_window(
+    window: std::sync::Arc<tokio::sync::Semaphore>,
+    ceiling: usize,
+    done: std::sync::Arc<std::sync::atomic::AtomicBool>,
+) {
+    tokio::spawn(async move {
+        let mut size = WINDOW_START.min(ceiling);
+        let mut best = 0f64;
+        let mut last = DOWNLOADED.load(std::sync::atomic::Ordering::Relaxed);
+        loop {
+            tokio::time::sleep(tokio::time::Duration::from_secs(3)).await;
+            if done.load(std::sync::atomic::Ordering::Relaxed) {
+                break;
+            }
+            let now = DOWNLOADED.load(std::sync::atomic::Ordering::Relaxed);
+            let rate = (now - last) as f64 / 3.0;
+            last = now;
+            if rate <= 0.0 {
+                continue;
+            }
+            if rate > best * 1.05 && size < ceiling {
+                let add = 2.min(ceiling - size);
+                window.add_permits(add);
+                size += add;
+            } else if rate < best * 0.6 && size > WINDOW_START {
+                if let Ok(permit) = window.clone().acquire_owned().await {
+                    permit.forget();
+                    size -= 1;
+                }
+            }
+            best = if rate > best { rate } else { best * 0.98 };
+        }
+    });
+}
