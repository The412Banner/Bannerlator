+fn request(value: Value) -> Result<Value, TokenStoreError> {
+    let name = std::env::var("DROIDDECK_XBOX_CREDENTIAL_SOCKET")
+        .map_err(|_| std::io::Error::other("Android credential host is unavailable"))?;
+    let address = SocketAddr::from_abstract_name(name)?;
+    let mut stream = UnixStream::connect_addr(&address)?;
+    stream.set_read_timeout(Some(Duration::from_secs(10)))?;
+    stream.set_write_timeout(Some(Duration::from_secs(10)))?;
+    serde_json::to_writer(&mut stream, &value)?;
+    stream.write_all(b"\n")?;
+    let mut bytes = Vec::new();
+    std::io::BufReader::new(stream).take(2_097_153).read_until(b'\n', &mut bytes)?;
+    if bytes.len() > 2_097_152 || bytes.last() != Some(&b'\n') {
+        return Err(std::io::Error::other("Invalid Android credential response").into());
+    }
+    let response: Value = serde_json::from_slice(&bytes)?;
+    if response["ok"] != true { return Err(std::io::Error::other("Android credential storage unavailable").into()); }
+    Ok(response)
 }
 
