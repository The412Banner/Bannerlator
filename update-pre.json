  "versionName": "3.1.7-pre4",
  "notes": "Bannerlator 3.1.7-pre4: Xbox / PC Game Pass store (sign-in, library + Game Pass, downloads, licensed launch, cloud saves); Steam account switching, extra library folders and Goldberg fixes; Wayland adapter by default; DirectAudio driver 1.4.0; on-screen controller and Games-screen fixes.",
  "highlights": [
    {
      "title": "Xbox store",
      "text": "Sign in with Microsoft, download your Xbox PC games and Game Pass titles, and play them with a licensed launch."
    },
    {
      "title": "Steam accounts",
      "text": "Switch between saved Steam accounts without signing in again, and install into extra library folders."
    },
    {
      "title": "Wayland adapter",
      "text": "The bundled adapter is the default, with profiles and smoother frames under GPU load."
    },
    {
      "title": "Smoother Games screen",
      "text": "Large store art no longer makes scrolling and the side menu stutter."
    }
  ],
