  "versionCode": 101,
  "versionName": "3.1.7-pre3",
  "notes": "Bannerlator 3.1.7-pre3: BANNERIN controller input (sticks stop when you let go), Direct XInput with rumble, controller settings changeable in game, DirectInput vibration, and save backups that include Steam emulator saves.",
  "highlights": [
    {
      "title": "BANNERIN controllers",
      "text": "Sticks follow the game's frame rate and stop the moment you let go; XInput games can read the pad directly, with rumble."
    },
    {
      "title": "Change controls in game",
      "text": "Controller type, XInput source, DirectInput and stick updates in Controls › Pad, without restarting."
    },
    {
      "title": "DirectInput vibration",
      "text": "DirectInput games can now vibrate the controller. On by default."
    },
    {
      "title": "Safer save backups",
      "text": "Backups now include the saves Steam emulators keep outside your user folder."
    }
  ],
