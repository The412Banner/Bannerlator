{
  "versionCode": 108,
  "versionName": "3.2.1",
  "notes": "Bannerlator 3.2.1: network drives in the file manager; Add to Games by copying from a drive; NAS streaming (experimental, work in progress); Lab is a full equal of Classic with a start-page choice and device details; DroidDeck drivers; XMB art pickers (MGamer404); Wayland and store fixes.",
  "highlights": [
    {
      "title": "Network drives",
      "text": "Find the shared drives on your network, add SMB, SFTP, WebDAV or FTP drives, browse them and copy both ways."
    },
    {
      "title": "Add to Games",
      "text": "Copy a game folder from a drive and add it in one step; the game's program is picked for you."
    },
    {
      "title": "NAS streaming (experimental)",
      "text": "Play a game straight from network storage without copying it first. Still a work in progress."
    },
    {
      "title": "Lab",
      "text": "Every Classic option in Lab, a start page of your choice, device details, outlined Library cards."
    },
    {
      "title": "XMB",
      "text": "Pick a game's wide cover and background, and a Home that follows the Interface scale (by MGamer404)."
    }
  ],
