{
  "versionCode": 105,
  "versionName": "3.1.9-pre1",
  "notes": "Bannerlator 3.1.9-pre1: new file manager (Home tiles, two panes, archives as folders) with a text editor for ini/cfg/txt/log; many more unpack formats (lzip, lzop, LZ4, ECM, ALZ, EGG, ACE, LZX, OTA, FreeArc layers); XMB interface style and controller keyboard; per-game mod manager (REFramework, Special K); Mali GPU support; Epic download and Ubisoft Connect fixes.",
  "highlights": [
    {
      "title": "File manager",
      "text": "Home tiles, a clickable path, two panes, archives that open like folders, compress, share and properties."
    },
    {
      "title": "Text editor",
      "text": "View, edit and save ini, cfg, txt and log files; their encoding and line endings stay as they were."
    },
    {
      "title": "More formats",
      "text": "Lzip, lzop, LZ4, ECM, ALZ, EGG, ACE, LZX, Android OTA files and FreeArc repacks with extra layers."
    },
    {
      "title": "XMB style",
      "text": "A console menu with a controller keyboard, also inside games (by MGamer404)."
    },
    {
      "title": "Mods per game",
      "text": "REFramework and Special K from a game's settings; switching one off removes its files."
    }
  ],
