{
  "versionCode": 99,
  "versionName": "3.1.7-pre1",
  "notes": "Bannerlator 3.1.7-pre1: the full Deck style (every screen, the settings editor and the in-game menus, controller-first, fits every display size); Windows components page in Deck; Remove for installed components (reverts their changes); smarter per-game component recommendations; first small (patch) update for 3.1.6 users.",
  "highlights": [
    {
      "title": "Deck style",
      "text": "The console-style interface now covers every screen, every setting and the in-game menus, made for controllers."
    },
    {
      "title": "Fits your screen",
      "text": "The Deck layout works at any display size, draws 20% smaller and keeps clear of a camera hole."
    },
    {
      "title": "Windows components",
      "text": "Recommended, optional and all components plus the DLL choices, right inside Deck for a game or container."
    },
    {
      "title": "Remove components",
      "text": "Take an installed component back out; the files and settings it changed are put back."
    },
    {
      "title": "Smarter suggestions",
      "text": "Recommendations come from the game's store, its Steam install script and the DLLs it loads."
    }
  ],
