{
  "versionCode": 106,
  "versionName": "3.1.9-pre2",
  "notes": "Bannerlator 3.1.9-pre2: Lab interface style for controllers (dashboard home, Library, Stores, game pages, settings, Contents, Controls, Save Manager, one in-game menu) in 32 languages; game art backgrounds, 3D art and trailers with a Game details page; first-run setup in Lab with Carbon & Ember and a step that creates your first container; Wayland adapter settings and help buttons in Lab; per-game Wayland logs and Share logs; file manager crash fix (#659).",
  "highlights": [
    {
      "title": "Lab style",
      "text": "A controller-first interface: dashboard home, Library, Stores, game pages, settings and one in-game menu."
    },
    {
      "title": "Game art",
      "text": "The selected game's art behind Home and the Library, 3D art, trailers, and a Game details page."
    },
    {
      "title": "First container",
      "text": "Setup downloads Proton, DXVK, VKD3D, FEXCore and a driver for your GPU, then creates a container."
    },
    {
      "title": "32 languages",
      "text": "Lab's screens, settings and explanations in 32 languages (Appearance › Language)."
    },
    {
      "title": "Wayland logs",
      "text": "Each game's Wayland logs in its own folder; Share logs sends the folder as one zip."
    }
  ],
