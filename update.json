{
  "versionCode": 103,
  "versionName": "3.1.7",
  "notes": "Bannerlator 3.1.7: Xbox / PC Game Pass store (sign-in, library + Game Pass, downloads, licensed launch, cloud saves) and Xbox Cloud Gaming (stream Game Pass games, optional native player with frame generation); the full Deck style and the XMB; BANNERIN controller input (sticks stop when you let go, Direct XInput, in-game controller settings, DirectInput vibration); Remove for Windows components, smarter recommendations and Wine Mono installs again; Steam account switching, extra library folders and Goldberg fixes; v15 layers with 144 Hz on the newest Wine builds; Wayland adapter by default; DirectAudio driver 1.4.0.",
  "highlights": [
    {
      "title": "Xbox store",
      "text": "Sign in with Microsoft, download your Xbox PC games and Game Pass titles, and play them with a licensed launch."
    },
    {
      "title": "Xbox Cloud Gaming",
      "text": "Stream Game Pass games, console-only ones too, with optional frame generation in the native player."
    },
    {
      "title": "Deck style",
      "text": "The console-style interface covers every screen, every setting and the in-game menus; the XMB is back, full screen."
    },
    {
      "title": "BANNERIN controllers",
      "text": "Sticks stop the moment you let go, XInput games can read the pad directly, and settings change in game."
    },
    {
      "title": "Windows components",
      "text": "Remove an installed component and get back what it changed; suggestions come from what the game uses."
    }
  ],
