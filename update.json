{
  "versionCode": 107,
  "versionName": "3.2.0",
  "notes": "Bannerlator 3.2.0: new Lab interface; XMB with a Steam Deck-style Home (MGamer404); Windows Steam client; one look for every store with download locations and game library import; new file manager and text editor; menu sounds; Xbox on Nexus 0.2.15.",
  "highlights": [
    {
      "title": "Lab interface",
      "text": "A controller-first dashboard, game pages, settings and one in-game menu, with game art, 32 languages and a first-run setup."
    },
    {
      "title": "XMB update",
      "text": "A Steam Deck-style Home, Stores, Downloads and Friends on one tabs page, and a new in-game menu (by MGamer404)."
    },
    {
      "title": "Windows Steam",
      "text": "Add Valve's 64-bit Steam client; your Steam store games show as installed, and it can start in Big Picture."
    },
    {
      "title": "Stores",
      "text": "One look for every store, a download location per store, and + Import game library for folders you already have."
    },
    {
      "title": "File manager",
      "text": "Archives that open like folders, two panes, a text editor, and more formats to unpack."
    }
  ],
