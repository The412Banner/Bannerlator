{
  "versionCode": 98,
  "versionName": "3.1.6",
  "notes": "Bannerlator 3.1.6: Headless Steam (the app's own Steam session hosts the game) with a working server browser; SteamLite Steam Input; Force SSBS CPU speed fix (on by default) with the new v14 layers; Win Components install without opening the container; smarter game adding with Steam art, details and an art picker; a redesigned update notice; small in-app updates from the next release on; plus Wayland xdg-shell v3, Mali (PanVK) Wayland settings, a Menu button for handhelds, Box64EC (experimental) and a fourth APK.",
  "highlights": [
    {
      "title": "Headless Steam",
      "text": "Steam games can run on the app's own Steam sign-in, with no Steam window, and the server browser works."
    },
    {
      "title": "Force SSBS",
      "text": "A CPU speed fix for Wine on ARM, on by default, carried by the new v14 layers."
    },
    {
      "title": "Win Components",
      "text": "VC++ runtimes, .NET, DirectX and more install in seconds without starting the container."
    },
    {
      "title": "Adding games",
      "text": "Better names, Steam art and details found for you, an art picker, and components suggested per game."
    },
    {
      "title": "Small updates",
      "text": "From the next release on, the app downloads only what changed instead of the whole app."
    }
  ],
